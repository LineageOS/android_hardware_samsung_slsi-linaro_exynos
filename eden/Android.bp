cc_library_headers {
    name: "eden_headers",
    host_supported: false,
    vendor_available: true,
    export_include_dirs: [ "include" ],
}

cc_library_shared {
    name: "libeden_nn_on_system",
    vendor: false,
    header_libs: [ "eden_headers" ],
    srcs: [
        "eden_nn.cpp",
        "eden_nn_api.cpp",
    ],
    shared_libs: [
        "liblog",
        "libeden_rt_stub.edensdk.samsung",
    ],
    cppflags: [
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
    ],
}

cc_library_shared {
    name: "libeden_nn_on_vendor",
    vendor: true,
    header_libs: [ "eden_headers" ],
    srcs: [
        "eden_nn.cpp",
        "eden_nn_api.cpp",
    ],
    shared_libs: [
        "liblog",
        "libeden_rt_stub_vendor.edensdk.samsung",
    ],
    cppflags: [
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
    ],
}

cc_library_shared {
    name: "libeden_rt_stub.edensdk.samsung",
    vendor: false,
    header_libs: [ "eden_headers" ],
    srcs: [
        "eden_rt_helper_system.cpp",
        "eden_rt_stub.cpp",
    ],
    shared_libs: [
        "liblog",
        "libhidlbase",
        "libutils",
        "libcutils",
        "vendor.samsung_slsi.hardware.eden_runtime@1.0",
        "libhidlmemory",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
    ],
    cppflags: [
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
    ],
}

cc_library_shared {
    name: "libeden_rt_stub_vendor.edensdk.samsung",
    header_libs: [ "eden_headers" ],
    vendor: true,
    srcs: [
        "eden_rt_helper_vendor.cpp",
        "eden_rt_stub.cpp",
    ],
    shared_libs: [
        "liblog",
        "libhidlbase",
        "libutils",
        "libcutils",
        "vendor.samsung_slsi.hardware.eden_runtime@1.0",
        "libion_exynos",
    ],
    cppflags: [
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
    ],
}

cc_library_shared {
    name: "libeden_gb_on_system",
    vendor: false,
    header_libs: [ "eden_headers" ],
    srcs: [
        "eden_gb.cpp",
        "eden_gb_api.cpp",
    ],
    shared_libs: [
        "liblog",
        "libeden_gpu_boost_stub.edensdk.samsung",
    ],
    cppflags: [
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
    ],
}

cc_library_shared {
    name: "libeden_gb_on_vendor",
    vendor: true,
    header_libs: [ "eden_headers" ],
    srcs: [
        "eden_gb.cpp",
        "eden_gb_api.cpp",
    ],
    shared_libs: [
        "liblog",
        "libeden_gpu_boost_stub_vendor.edensdk.samsung",
    ],
    cppflags: [
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
    ],
}

cc_library_shared {
    name: "libeden_gpu_boost_stub.edensdk.samsung",
    vendor: false,
    srcs: [
        "eden_gpu_boost_stub.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "libutils",
        "libcutils",
        "vendor.samsung_slsi.hardware.enn_aux@1.0"
    ],
}

cc_library_shared {
    name: "libeden_gpu_boost_stub_vendor.edensdk.samsung",
    vendor: true,
    srcs: [
        "eden_gpu_boost_stub.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "libutils",
        "libcutils",
        "vendor.samsung_slsi.hardware.enn_aux@1.0"
    ],
}

subdirs=[
    "driver",
    "libs",
]
