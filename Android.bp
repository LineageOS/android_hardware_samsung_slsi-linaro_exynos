soong_namespace {
    imports:[
        "hardware/samsung_slsi-linaro/graphics",
        "hardware/samsung_slsi-linaro/interfaces",
        "hardware/samsung_slsi-linaro/openmax"
    ],
}

soong_config_module_type {
    name: "libexynos_headers_c2_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "exynos_headers_c2",
    variables: [
        "full_st2094_40",
    ],
    properties: [
        "cflags",
    ],
}

soong_config_bool_variable {
    name: "full_st2094_40",
}

libexynos_headers_c2_cc_defaults {
    name: "libexynos_headers_c2_defaults",
    soong_config_variables: {
        full_st2094_40: {
            cflags: ["-DUSE_FULL_ST2094_40"],
        }
    }
}

cc_library_headers {
    name: "libexynos_headers",
    header_libs: [
        "libaudio_system_headers",
        "libhardware_headers",
        "libsystem_headers",
        "libcutils_headers",
    ],
    export_header_lib_headers: [
        "libaudio_system_headers",
        "libsystem_headers",
        "libcutils_headers",
        "libhardware_headers",
    ],

    export_include_dirs: ["include"],
    proprietary: true,
}

soong_config_module_type {
    name: "grallocwrapper_defaults",
    module_type: "cc_defaults",
    config_namespace: "libgrallocwrapper",
    variables: [
        "gralloc_version",
    ],
    properties: [
        "srcs", "include_dirs", "shared_libs", "static_libs",
    ],
}

soong_config_string_variable {
    name: "gralloc_version",
    values: ["none", "one", "three", "four", "four_sgr"],
}

grallocwrapper_defaults {
    name: "grallocwrapper_defaults",
    soong_config_variables: {
        gralloc_version: {
            one: {
                srcs: [
                    "gralloc1/GrallocWrapper.cpp",
                ],
                include_dirs: [
                    "hardware/samsung_slsi-linaro/exynos/include",
                    "hardware/samsung_slsi-linaro/exynos5/include",
                    "system/core/libsync/include",
                ],
                shared_libs: [
                    "liblog",
                    "libcutils",
                    "libion_exynos",
                    "libutils",
                    "android.hardware.graphics.allocator@2.0",
                    "android.hardware.graphics.mapper@2.0",
                    "libsync",
                    "libhardware",
                    "libhidlbase",
                ],
            },
            three: {
                srcs: [
                    "gralloc3/src/GrallocWrapper.cpp",
                ],
                include_dirs: [
                    "hardware/samsung_slsi-linaro/exynos/include",
                ],
                shared_libs: [
                    "liblog",
                    "libcutils",
                    "libutils",
                    "android.hardware.graphics.allocator@2.0",
                    "android.hardware.graphics.mapper@2.0",
                    "libsync",
                    "libhardware",
                    "libhidlbase",
                ],
            },
        },
    },
}

cc_library_shared {
    name: "libGrallocWrapper",
    vendor: true,
    defaults: [
        "grallocwrapper_defaults",
    ],
}

subdirs = ["*"]
