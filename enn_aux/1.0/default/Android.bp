cc_library_shared {
    name: "vendor.samsung_slsi.hardware.enn_aux@1.0-impl",
    proprietary: true,
    srcs: ["ENN_AUX.cpp"],
    cppflags: [
        "-fexceptions",
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
    ],
    include_dirs: [
        "hardware/samsung_slsi-linaro/exynos/include",
    ],
    header_libs: [
        "eden_headers"
    ],
    shared_libs: [
        "libutils",
        "libcutils",
        "libhidlbase",
        "libbinder",
        "libsync",
        "liblog",
        "libhardware",
        "vendor.samsung_slsi.hardware.enn_aux@1.0",
        "android.hidl.memory@1.0",
        "libhidlmemory",
    ],
}

cc_binary {
    name: "vendor.samsung_slsi.hardware.enn_aux@1.0-service",
    init_rc: ["vendor.samsung_slsi.hardware.enn_aux@1.0-service.rc"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: ["service.cpp"],
    shared_libs: [
        "libutils",
        "libcutils",
        "libhidlbase",
        "libbinder",
        "liblog",
        "libsync",
        "libhardware",
        "libhidlmemory",
        "android.hidl.memory@1.0",
        "vendor.samsung_slsi.hardware.enn_aux@1.0",
        "vendor.samsung_slsi.hardware.enn_aux@1.0-impl",
    ],
}
