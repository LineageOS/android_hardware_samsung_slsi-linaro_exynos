cc_defaults {
    name: "gralloc1_defaults",
    relative_install_path: "hw",
    include_dirs: [
        "hardware/samsung_slsi-linaro/exynos/include",
        "hardware/samsung_slsi-linaro/exynos5/include",
        "system/core/libsync/include",
    ],
    cflags: [
        "-DLOG_TAG=\"gralloc\"",
        "-Wno-missing-field-initializers",
    ] + select(soong_config_variable("arm_gralloc", "GRALLOC_RANGE_FLUSH"), {
        "true": ["-DGRALLOC_RANGE_FLUSH"],
        default: [],
    }) + select(soong_config_variable("arm_gralloc", "uses_align_restriction"), {
        "true": ["-DGRALLOC_MSCL_ALIGN_RESTRICTION"],
        default: [],
    }) + select(soong_config_variable("arm_gralloc", "uses_10b_align_restriction"), {
        "true": ["-DGRALLOC_10B_ALIGN_RESTRICTION"],
        default: [],
    }) + select(soong_config_variable("arm_gralloc", "exynos_s10b_format_align"), {
        "64": ["-DBOARD_EXYNOS_S10B_FORMAT_ALIGN=64"],
        default: ["-DBOARD_EXYNOS_S10B_FORMAT_ALIGN=16"],
    }) + select(soong_config_variable("arm_gralloc", "MFC_CHROMA_VALIGN"), {
        any @ flag_val: [
            "-DCHROMA_VALIGN=" + flag_val,
            "-DEXYNOS_CHROMA_VSTRIDE_ALIGN",
        ],
        default: [],
    }),

    shared_libs: [
        "liblog",
        "libcutils",
        "libion_exynos",
        "libutils",
        "libsync",
        "libhardware",
        "libion",
    ],

    header_libs: ["libhardware_headers"],

    owner: "samsung_arm",
    proprietary: true,

    compile_multilib: "both",

    srcs: [
        "framebuffer.cpp",
        "mali_gralloc_bufferaccess.cpp",
        "mali_gralloc_bufferallocation.cpp",
        "mali_gralloc_bufferdescriptor.cpp",
        "mali_gralloc_formats.cpp",
        "mali_gralloc_public_interface.cpp",
        "mali_gralloc_reference.cpp",
    ],
}

cc_library_shared {
    name: "gralloc.exynos8895",
    defaults: ["gralloc1_defaults"],
}
