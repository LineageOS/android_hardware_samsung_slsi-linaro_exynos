soong_namespace {
    imports:[
        "hardware/samsung_slsi-linaro/graphics",
    ],
}

cc_library_headers {
    name: "libgralloc3_headers_exynos",
    vendor: true,
    host_supported: true,
    export_include_dirs: [
        ".",
    ],
    header_libs: [
        "libsystem_headers",
    ],
    export_header_lib_headers: [
        "libsystem_headers",
    ],
}

//
// Copyright (C) 2016-2019 ARM Limited. All rights reserved.
