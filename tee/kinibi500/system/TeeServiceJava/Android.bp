cc_library_shared {

    name: "libTeeServiceJni",

    srcs: [
        "jni/native-lib-jni.cpp",
        "jni/TeeCallback.cpp",
    ],

    include_dirs: [
        "hardware/samsung_slsi-linaro/exynos/tee/kinibi500/system/TeeService",
        "hardware/samsung_slsi-linaro/exynos/tee/kinibi500/vendor/hardware/interfaces/tee/1.1/default",
    ],

    cflags: [
        "-UNDEBUG", // Undefine NDEBUG to enable LOG_D in log
        "-DLOG_ANDROID", // Enable logging to logcat per default
    ],

    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "liblog",
        "libbinder",
        "libdl",
        "libgui",
        "libui",
        "libselinux",
        "libhidlbase",
        "libhidlmemory",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
        "vendor.trustonic.tee@1.1",
    ],

    static_libs: ["libteeservice_server"],

}

android_app {
    name: "TeeService",

    optimize: {
        enabled: false,
    },
    srcs: ["java/**/*.java"],
    jni_libs: ["libTeeServiceJni"],
    static_libs: [
        "android.hidl.base-V1.0-java",
        "vendor.trustonic.tee.tui-V1.0-java",
    ],
    privileged: true,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    platform_apis: true,

}
