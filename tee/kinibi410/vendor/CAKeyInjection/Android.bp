cc_binary {

    name: "caKeyInjectionTool",
    proprietary: true,
    srcs: [
        "src/*.cpp",
        "src/*.c",
    ],

    local_include_dirs: [
        "src",
        ".",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-DTBASE_API_LEVEL=11",
        "-DLOG_ANDROID", // Enable logging to logcat by default
        "-DLOG_TAG=\"caKeyInjectionTool\"",
    ],

    shared_libs: [
        "libMcClient",
        "liblog",
    ],

}
