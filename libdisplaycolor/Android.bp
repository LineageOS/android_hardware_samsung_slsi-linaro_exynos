cc_library_headers {
    name: "libdisplaycolor_interface",
    proprietary: true,
    export_include_dirs: ["include"],
}

cc_library {
    name: "libdisplaycolor_default",
    proprietary: true,
    srcs: ["libdisplaycolor_default.cpp"],
    shared_libs: [
        "liblog",
        "libxml2",
        "libcutils",
        "libutils",
    ],
    header_libs: ["libdisplaycolor_interface"],
    cflags: ["-Werror"],
}

cc_library {
    name: "libdisplaycolor_test",
    proprietary: true,
    srcs: ["libdisplaycolor_test.cpp"],
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libdisplaycolor_default",
    ],
    header_libs: ["libdisplaycolor_interface"],
    cflags: ["-Wno-unused-function"],
}
