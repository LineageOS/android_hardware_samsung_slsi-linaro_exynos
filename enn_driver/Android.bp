/* Eden driver */
cc_defaults {
    name: "NeuralNetworksEdenDriver_defaults",
    // openmp: true,
    srcs: [
        "EdenDriver.cpp",
        "NNAgent.cpp",
        "ModelConverter.cpp",
        "EdenModelConvertLib.cpp",
        "CompilerManager.cpp",
        "GraphGenManager.cpp",
        "NpucIrConverter.cpp",
        "NNNetworkBuilder.cpp",
        "EdenPreparedModel.cpp",
        "BufferInfoOnExecute.cpp",
        "PrePostProcessor.cpp",
        "ResourceManager.cpp",
        "SchedulePolicy.cpp",
        "ExecutionScheduler.cpp",
        "EdenServiceDelegatorLib.cpp",
        "EnnServiceDelegatorLib.cpp",
        "ErrorHandler.cpp",
        "ModelOptimizer.cpp",
        "MyUtils.cpp",
        "BufferManager.cpp"
    ],
    header_libs: [
        "libneuralnetworks_headers",
        "eden_headers",
        "npuc_headers",
        "graphgen_headers",
    ],
    cflags: [
        "-DEDEN64",
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
        "-DCONFIG_NPU_MEM_ION",
    ],
    cppflags: [
        "-DEDEN64",
        "-DEDEN_DEBUG",
        "-DANDROID_LOG",
        "-DCONFIG_NPU_MEM_ION",
        "-DONDEVICE_COMPILER",
        "-Wno-error=overloaded-virtual",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libdl",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "libhidlmemory",
        "libnativewindow",
        "libtextclassifier_hash",
        "liblog",
        "libui",
        "libutils",
        "libsync",
        "android.hardware.neuralnetworks@1.0",
        "android.hardware.neuralnetworks@1.1",
        "android.hardware.neuralnetworks@1.2",
        "android.hardware.neuralnetworks@1.3",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
    ],
    static_libs: [
        "libneuralnetworks_common",
    ],
}

/* declare service server as default */
cc_defaults {
    name: "NeuralNetworksEdenDriver_server_defaults",
    defaults: [
        "NeuralNetworksEdenDriver_defaults",
       /* "ofi_vendor_defaults", */
    ],
    relative_install_path: "hw",
    proprietary: true,
    shared_libs: [
        "libeden_nn",
        "libeden_rt",
        "libeden_model",
        "libeden_osal",
        "libeden_ud_cpu",
        "libeden_ud_npu",
        "libeden_ud_gpu",
        "libeden_xtool",

        "libnpuc_api",
        "libnpuc_backend",
        "libnpuc_cmdq",
        "libnpuc_common",
        "libnpuc_controller",
        "libnpuc_frontend",
        "libnpuc_graph",
        "libnpuc_template",

        "libgraphgen_api",
        "libgraphgen_import",
        "libgraphgen_ann_import",
        "libgraphgen_ann_nnc",
        "libgraphgen_misc",
        "libgraphgen_network",
        "libgraphgen_intermediate_process",
        "libgraphgen_export",
        "libcommon",
        "libcrane_compiler",
        "libir",
        "libnpu_compiler",
        "libsait_npu_compiler",
    ],
    target: {
        android_x86_64: {
           enabled: false,
        },
        android_x86: {
           enabled: false,
        },
   },
/*
    whole_static_libs: [
        "npuc_static",
    ],
*/
}

cc_binary {
    name: "android.hardware.neuralnetworks@1.3-service.eden-drv",
    defaults: ["NeuralNetworksEdenDriver_server_defaults"],
    init_rc: ["android.hardware.neuralnetworks@1.3-service.eden-drv.rc"],
    srcs: ["EdenDriverLib.cpp"],
    target: {
        android_x86_64: {
           enabled: false,
        },
        android_x86: {
           enabled: false,
        },
   },
}

