+        LOGI(EDEN_HIDL, "(Not service)User Process of cookie[pid=%lu] DIED \n", cookie);
         has_died_ = true;
         // Clean up resources
         int64_t pid = (int64_t)cookie;
-        LOGD(EDEN_HIDL, "Set mapPidAlive[%lld] to false\n", pid);
+        LOGD(EDEN_HIDL, "Set mapPidAlive[%ld] to false\n", pid);
