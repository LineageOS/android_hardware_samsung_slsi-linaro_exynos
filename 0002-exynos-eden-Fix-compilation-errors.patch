                         if (IsValidPID(pid) == true) {
                             // Keep alive pid data
@@ -454,11 +454,11 @@ class EdenruntimeDeathRecipient : public android::hardware::hidl_death_recipient
     EdenruntimeDeathRecipient(const sp<IEdenruntime> rt) : mRt_(rt), has_died_(false) {}
 
