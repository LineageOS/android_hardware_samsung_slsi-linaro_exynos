soong_namespace {}

cc_binary {
    name: "cbd",
    proprietary: true,
    cpp_std: "c++17",

    include_dirs: [
        "bionic/libc/bionic",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-D_GNU_SOURCE",
        "-DCONFIG_TYPE_MODAP",
        "-DCONFIG_TYPE_EXT",
    ] + select(soong_config_variable("cbd", "protocol"), {
        "sit": ["-DCONFIG_PROTOCOL_SIT"],
        "sipc": ["-DCONFIG_SEC_CP_VERIFYING_ALL"],
        default: [],
    }) + select(soong_config_variable("cbd", "use_legacy_ioctl"), {
        true: ["-DLEGACY_IOCTL"],
        default: [],
    }) + select(soong_config_variable("cbd", "use_legacy_sipc_ioctl"), {
        true: ["-DLEGACY_SIPC_IOCTL"],
        default: [],
    }),

    srcs: [
        "main.cpp",
        "BootDump.cpp",
        "BootDumpModap.cpp",
        "BootDumpExt.cpp",
        "Container.cpp",
        "Protocol.cpp",
        "Srinfo.cpp",
        "Util.cpp",
        "Log.cpp",
    ] + select(soong_config_variable("cbd", "protocol"), {
        "sit": [
            "ProtocolSit.cpp",
            "SrinfoSit2.cpp",
        ],
        "sipc": [
            "ProtocolSipc.cpp",
            "SrinfoSipc.cpp",
        ],
        default: [],
    }),

    shared_libs: [
        "liblog",
        "libcutils",
        "libc",
        "libselinux",
    ],
}

cc_binary {
    name: "cld",
    static_executable: false,
    proprietary: true,
    stem: "cld",

    srcs: ["lb_main.c"],

    include_dirs: ["bionic/libc/bionic"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libc",
    ],
}
