
cc_defaults {
    name: "cbd_v3.defaults",
    static_executable: false,
    proprietary: true,
    cpp_std: "c++17",
    stem: "cbd",

    include_dirs: [
        "bionic/libc/bionic",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-D_GNU_SOURCE",
        "-DCONFIG_TYPE_MODAP",
        "-DCONFIG_TYPE_EXT",
    ],

    srcs: [
        "main.cpp",
        "BootDump.cpp",
        "BootDumpModap.cpp",
        "BootDumpExt.cpp",
        "Container.cpp",
        "Protocol.cpp",
        "Srinfo.cpp",
        "Util.cpp",
        "Log.cpp",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libc",
        "libselinux",
    ],
}

cc_defaults {
    name: "cbd_v3.sit.defaults",
    defaults: ["cbd_v3.defaults"],
    cflags: [
        "-DCONFIG_PROTOCOL_SIT",
    ],
    srcs: [
        "ProtocolSit.cpp",
        "SrinfoSit2.cpp",
    ],
}

cc_binary {
    name: "cbd_v3.sit",
    defaults: ["cbd_v3.sit.defaults"],
}

cc_binary {
    name: "cbd_v3.sit.legacy",
    defaults: ["cbd_v3.sit.defaults"],
    cflags: [
        "-DLEGACY_IOCTL",
    ],
}
cc_binary {
    name: "cbd_v3.sipc",
    defaults: ["cbd_v3.defaults"],
    cflags: [
        "-DCONFIG_SEC_CP_VERIFYING_ALL",
    ],
    srcs: [
        "ProtocolSipc.cpp",
        "SrinfoSipc.cpp",
    ],
}

cc_defaults {
    name: "cld_v3.defaults",
    static_executable: false,
    proprietary: true,
    stem: "cld",

    include_dirs: ["bionic/libc/bionic"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libc",
    ],
}

cc_binary {
    name: "cld_v3.sit",
    defaults: ["cld_v3.defaults"],
}
cc_binary {
    name: "cld_v3.sipc",
    defaults: ["cld_v3.defaults"],
    srcs: ["lb_main.c"],
}
