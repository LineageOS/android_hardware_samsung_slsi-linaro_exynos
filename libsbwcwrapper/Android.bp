cc_library_shared {

    name: "libsbwcwrapper",

    proprietary: true,

    defaults: [
        "libexynos_headers_c2_defaults",
    ],

    cflags: [
        "-DLOG_TAG=\"sbwcwrapper\"",
    ] + select(soong_config_variable("sbwcwrapper", "sbwcwrapper_priority"), {
        "mscl": ["-DLIBSBWC_DECODER_PRIORITY=\"Mscl\""],
        "dpuMscl": ["-DLIBSBWC_DECODER_PRIORITY=\"DpuMscl\""],
        default: ["-DLIBSBWC_DECODER_PRIORITY=\"Dummy\""],
    }) + select(soong_config_variable("sbwcdpu", "enabled"), {
        true: ["-DLIBSBWC_DPU_ENABLED"],
        default: [],
    }),

    shared_libs: [
        "liblog",
        "libui",
        "libutils",
        "libcutils",
        "libion",
        "libion_exynos",
        "libsync",
        "libexynosgraphicbuffer",
        "libacryl",
    ],
    static_libs: [
        "libsbwc",
    ] + select(soong_config_variable("sbwcdpu", "enabled"), {
        true: ["libsbwc-dpu"],
        default: [],
    }),

    header_libs: ["libexynos_headers"],

    export_include_dirs: ["include"],

    srcs: [
        "sbwcwrapper.cpp",
        "sbwcwrapper_mscl.cpp",
    ],
}
