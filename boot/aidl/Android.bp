package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "android.hardware.boot-service.exynos_common",
    relative_install_path: "hw",
    vintf_fragments: ["android.hardware.boot-service.exynos.xml"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "libhardware",
        "libutils",
        "android.hardware.boot@1.0",
        "android.hardware.boot@1.1",
        "android.hardware.boot@1.2",
        "android.hardware.boot-V1-ndk",
    ],
    static_libs: [
        "exsl.v1_2.defaults",
        "exynos_bootctrl_1.2_lib",
        "lib_exynos_message",
        "lib_exbc.v1",
        "libfstab",
    ],
    srcs: ["main.cpp", "BootControl.cpp"],
}

cc_binary {
    name: "android.hardware.boot-service.exynos",
    defaults: ["android.hardware.boot-service.exynos_common"],
    init_rc: ["android.hardware.boot-service.exynos.rc"],
    vendor: true,
}

cc_binary {
    name: "android.hardware.boot-service.exynos_recovery",
    defaults: ["android.hardware.boot-service.exynos_common"],
    init_rc: ["android.hardware.boot-service.exynos_recovery.rc"],
    recovery: true,
}
